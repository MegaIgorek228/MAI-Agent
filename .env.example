APP_ENV=development
DATABASE_URL=postgresql+psycopg://mai_agent:change_me@localhost:5432/mai_agent
POSTGRES_DB=mai_agent
POSTGRES_USER=mai_agent
POSTGRES_PASSWORD=change_me
JWT_SECRET_KEY=change_me_in_local_environment
ACP_TRANSPORT=stdio
HERMES_COMMAND=hermes-acp
HERMES_CWD=.
ACP_STARTUP_TIMEOUT_SECONDS=180
ACP_PROMPT_TIMEOUT_SECONDS=600
HERMES_MAX_PROCESSES=8
HERMES_IDLE_TIMEOUT_SECONDS=900
HERMES_MODEL=deepseek-v4.1-flash
HERMES_BASE_URL=https://api-ai.mai.ru/v1
HERMES_REASONING_EFFORT=low
MCP_PUBLIC_URL=http://localhost:8000/mcp
LLM_BASE_URL=https://api-ai.mai.ru/v1
LLM_API_KEY=
DOCUMENT_MODEL=deepseek-v4.1-flash
AI_API_CA_BUNDLE=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
MAX_UPLOAD_SIZE_BYTES=10485760
EMBEDDING_DIMENSIONS=1024
OFFICIAL_SOURCE_DOMAINS=mai.ru,priem.mai.ru
OFFICIAL_SOURCE_ROOT_URLS=https://mai.ru,https://priem.mai.ru
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING_TIMEOUT_SECONDS=10

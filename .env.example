APP_ENV=development
# Backend service database (operational data only: agent_sessions,
# telegram_checkpoints). Two more databases live on the same Postgres
# server: mai_agent (the agent's own DB: applicants, applications,
# ege_scores, ratings, knowledge_*) and mai_fis_gia (synthetic ФИС ГИА:
# EGE results source) — both are created automatically at backend startup.
DATABASE_URL=postgresql+psycopg://mai_agent:***@localhost:5432/mai_backend
POSTGRES_DB=mai_backend
POSTGRES_USER=mai_agent
POSTGRES_PASSWORD=change_me
ACP_TRANSPORT=stdio
HERMES_COMMAND=hermes-acp
HERMES_CWD=.
ACP_STARTUP_TIMEOUT_SECONDS=180
ACP_PROMPT_TIMEOUT_SECONDS=600
HERMES_MAX_PROCESSES=8
HERMES_IDLE_TIMEOUT_SECONDS=900
HERMES_MODEL=deepseek-v4.1-flash
HERMES_BASE_URL=https://api-ai.mai.ru/v1
HERMES_REASONING_EFFORT=low
MCP_PUBLIC_URL=http://localhost:8000/mcp
LLM_BASE_URL=https://api-ai.mai.ru/v1
LLM_API_KEY=
AI_API_CA_BUNDLE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING_TIMEOUT_SECONDS=10
